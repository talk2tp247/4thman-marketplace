// src/app/api/auth/signin/route.ts (UPDATED with Refresh Token)

import { NextResponse } from 'next/server'
import { PrismaClient } from '@prisma/client'
import bcrypt from 'bcryptjs'
import { generateTokenPair } from '@/lib/jwt'

const prisma = new PrismaClient()

export async function POST(req: Request) {
  try {
    const { email, password } = await req.json()

    const user = await prisma.user.findUnique({ where: { email } })
    if (!user) {
      return NextResponse.json(
        { error: 'Invalid email or password' },
        { status: 401 }
      )
    }

    const validPassword = await bcrypt.compare(password, user.password)
    if (!validPassword) {
      return NextResponse.json(
        { error: 'Invalid email or password' },
        { status: 401 }
      )
    }

    // ✅ Generate BOTH access + refresh tokens
    const { accessToken, refreshToken } = generateTokenPair({
      userId: user.id,
      email: user.email,
      accountType: user.accountType as 'buyer' | 'seller' | 'admin',
    })

    // Create response with user data
    const response = NextResponse.json(
      {
        id: user.id,
        name: user.name,
        email: user.email,
        accountType: user.accountType,
        storeName: user.storeName,
      },
      { status: 200 }
    )

    // ✅ Set ACCESS TOKEN cookie (7 days)
    response.cookies.set('authToken', accessToken, {
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'lax',
      maxAge: 7 * 24 * 60 * 60, // 7 days
    })

    // ✅ Set REFRESH TOKEN cookie (365 days / 1 YEAR)
    response.cookies.set('refreshToken', refreshToken, {
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'lax',
      maxAge: 365 * 24 * 60 * 60, // 365 days = 1 YEAR
    })

    return response
  } catch (error) {
    return NextResponse.json({ error: 'Sign in failed' }, { status: 500 })
  }
}
